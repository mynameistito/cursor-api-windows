{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["knip", "tsgo", "where"],
  "workspaces": {
    "apps/cli": {
      "entry": ["scripts/*.ts", "bridge/cursor-sdk-local-agent-bridge.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "bridge/**/*.mjs"],
      "ignoreDependencies": ["@cursor/sdk", "@typescript/native"]
    },
    "apps/web": {
      "ignoreDependencies": ["@typescript/native"]
    }
  }
}
