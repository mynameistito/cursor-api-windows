{
  "name": "@cursor-api-windows/cli",
  "version": "0.1.18",
  "private": true,
  "description": "CLI for a local OpenAI-compatible Cursor API on Windows.",
  "keywords": [
    "cli",
    "composer",
    "cursor",
    "openai",
    "windows"
  ],
  "homepage": "https://github.com/mynameistito/cursor-api-windows#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/cursor-api-windows/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/cursor-api-windows.git"
  },
  "bin": {
    "cursor-api": "./dist/cursor-api/cursor-api.exe"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "stage:bridge": "bun run scripts/stage-bridge.ts",
    "test": "vitest run",
    "check": "ultracite check",
    "knip": "knip",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  }
}
